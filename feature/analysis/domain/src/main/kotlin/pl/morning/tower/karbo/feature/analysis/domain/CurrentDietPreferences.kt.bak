package pl.morning.tower.karbo.feature.analysis.domain

import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.onEmpty
import pl.morning.tower.karbo.core.common.ErrorReporter
import pl.morning.tower.karbo.core.common.catchAppError
import pl.morning.tower.karbo.feature.preferences.api.DietPreferencesRepository
import pl.morning.tower.karbo.feature.preferences.api.model.DietPreferences

internal const val CURRENT_DIET_PREFERENCES_TAG = "CurrentDietPreferences"

internal fun DietPreferencesRepository.currentDietPreferences(errorReporter: ErrorReporter): Flow<DietPreferences> =
    observeDietPreferences()
        .catchAppError { error ->
            errorReporter.report(tag = CURRENT_DIET_PREFERENCES_TAG, message = "Loading diet preferences failed", error = error)
        }
        .onEmpty { emit(DietPreferences.Default) }
